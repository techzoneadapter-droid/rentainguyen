# Copy this file to .env.local and fill values locally.
# Never commit real access tokens or encryption secrets.

# Optional legacy/default token used by workspace-wide Meta sync.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0

# Required for Facebook OAuth inside the token workspace.
# META_APP_ID is public; META_APP_SECRET must stay server-side and must never be committed.
META_APP_ID=
META_APP_SECRET=
# Optional. Leave blank locally to use http://localhost:5173/api/meta-oauth/callback automatically.
# In production set the exact callback URL registered in Meta App settings.
META_OAUTH_REDIRECT_URI=

# Required for the /tokens vault. Use a long random value (32+ characters recommended).
# Example generation with Node:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# BVAGC CRM resource supply gateway.
# Generate the one-time key in BVAGC CRM > Kho tài nguyên > Cổng nguồn tài khoản > Tạo khóa kết nối.
# Keep the key server-side. It is never returned to the browser by this app.
BVAGC_RESOURCE_GATEWAY_URL=https://zcxoennnjizibvzokwaz.supabase.co/functions/v1/resource-supply-gateway
BVAGC_RESOURCE_API_KEY=

# Optional override for the file-backed Bí kíp bridge.
# Leave this value as-is when the CRM is deployed at bvagc.vercel.app.
BVAGC_GUIDE_GATEWAY_URL=https://bvagc.vercel.app/api/resource-guide-gateway
