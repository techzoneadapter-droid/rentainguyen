# Copy this file to .env.local and fill values locally.
# Never commit real access tokens or encryption secrets.

# Optional legacy/default token used by workspace-wide Meta sync.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0

# Required for the /tokens vault. Use a long random value (32+ characters recommended).
# Example generation with Node:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
